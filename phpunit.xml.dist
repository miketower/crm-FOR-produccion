<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="vendor/codeigniter4/framework/system/Test/bootstrap.php"
         cacheDirectory="writable/cache/phpunit"
         backupGlobals="false"
         colors="true"
         failOnEmptyTestSuite="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="App">
            <directory suffix="Test.php">./tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
        <exclude>
            <directory>./app/Views</directory>
            <file>./app/Config/Routes.php</file>
        </exclude>
    </source>
    <logging>
        <junit outputFile="writable/logs/phpunit/junit.xml"/>
    </logging>
    <php>
        <server name="CI_ENVIRONMENT" value="testing" force="true"/>
        <server name="app.baseURL" value="http://localhost/" force="true"/>
        <server name="database.tests.DBDriver" value="SQLite3" force="true"/>
        <server name="database.tests.database" value=":memory:" force="true"/>
        <server name="database.tests.DBPrefix" value="db_" force="true"/>
        <const name="HOMEPATH" value="./"/>
        <const name="CONFIGPATH" value="./app/Config/"/>
        <const name="PUBLICPATH" value="./public/"/>
    </php>
</phpunit>
